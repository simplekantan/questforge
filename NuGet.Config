<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="Dalamud" value="https://dalamud.dev/nuget/" />
  </packageSources>

  <!--
    Package Source Mapping: tell NuGet exactly which source to use for each package.
    Without this, NuGet queries *all* sources for *every* package. Since dalamud.dev
    returns 404 for standard packages, that generates NU1801 errors in projects that
    have TreatWarningsAsErrors (e.g. engine tests).

    Rule: Dalamud-ecosystem packages from dalamud.dev; everything else from nuget.org.
    The wildcard "*" on nuget.org catches all packages not explicitly listed for Dalamud.
  -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="Dalamud">
      <package pattern="Dalamud" />
      <package pattern="Dalamud.*" />
      <package pattern="Dalamud.NET.Sdk" />
      <package pattern="FFXIVClientStructs" />
      <package pattern="ECommons" />
    </packageSource>
  </packageSourceMapping>
</configuration>
